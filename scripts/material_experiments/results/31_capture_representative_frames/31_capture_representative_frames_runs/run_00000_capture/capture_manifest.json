{
  "format": "png",
  "pixel_format": "DXGI_FORMAT_R8G8B8A8_UNORM",
  "width": 1920,
  "height": 1080,
  "warmup_frames": 60,
  "measure_frames": 120,
  "capture_stride": 120,
  "capture_fps": 60,
  "captured_frame_count": 1,
  "frame_name_pattern": "frames/frame_%06d.png",
  "frame_mapping": "measurement_frame = image_index * capture_stride",
  "frames": [
    {
      "image_index": 0,
      "render_frame": 60,
      "measurement_frame": 0,
      "path": "${RUN_TEMP}/run_00000_capture/frames/frame_000000.png"
    }
  ]
}
