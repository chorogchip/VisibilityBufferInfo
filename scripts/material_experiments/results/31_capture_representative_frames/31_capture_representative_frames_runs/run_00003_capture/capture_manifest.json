{
  "format": "png",
  "pixel_format": "DXGI_FORMAT_R8G8B8A8_UNORM",
  "width": 1920,
  "height": 1080,
  "warmup_frames": 60,
  "measure_frames": 600,
  "capture_stride": 120,
  "capture_fps": 60,
  "captured_frame_count": 5,
  "frame_name_pattern": "frames/frame_%06d.png",
  "frame_mapping": "measurement_frame = image_index * capture_stride",
  "frames": [
    {
      "image_index": 0,
      "render_frame": 60,
      "measurement_frame": 0,
      "path": "${RUN_TEMP}/run_00003_capture/frames/frame_000000.png"
    },
    {
      "image_index": 1,
      "render_frame": 180,
      "measurement_frame": 120,
      "path": "${RUN_TEMP}/run_00003_capture/frames/frame_000001.png"
    },
    {
      "image_index": 2,
      "render_frame": 300,
      "measurement_frame": 240,
      "path": "${RUN_TEMP}/run_00003_capture/frames/frame_000002.png"
    },
    {
      "image_index": 3,
      "render_frame": 420,
      "measurement_frame": 360,
      "path": "${RUN_TEMP}/run_00003_capture/frames/frame_000003.png"
    },
    {
      "image_index": 4,
      "render_frame": 540,
      "measurement_frame": 480,
      "path": "${RUN_TEMP}/run_00003_capture/frames/frame_000004.png"
    }
  ]
}
